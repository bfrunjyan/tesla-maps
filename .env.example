# Copy to .env.local for local development (never commit real values).

# Postgres. Railway: reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:54340/teslamaps

# Public URL of the app (HTTPS on Railway). Used for the Google redirect and secure cookies.
APP_URL=http://localhost:5174

# Email sign-in codes (Resend). Without these, codes are printed to the server log in
# development and the "Email me a code" option is hidden in production.
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in. Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chargers: countries to load (ISO codes), and an optional free Open Charge Map key
# (openchargemap.org) that adds power and connector data.
CHARGER_COUNTRIES=AM
OCM_API_KEY=

# Connect Tesla (optional): reads charge level, range and charging state from the driver's
# car through the Tesla Fleet API. Hidden until the client ID and secret are set.
# Setup steps are in README.md ("Connect Tesla"). Tesla bills each reading (about $0.002).
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# The app's public key (PEM), served at /.well-known/appspecific/com.tesla.3p.public-key.pem
TESLA_PUBLIC_KEY=
# Most readings per driver per day (default 60).
TESLA_DAILY_READS=
# Local development: TESLA_FAKE=1 uses a stand-in for Tesla, no keys needed (npm run dev:api:tesla).

# Optional: live traffic (Mapbox Traffic v1 tiles). Baked in at build time.
VITE_MAPBOX_TOKEN=
# Optional (test): Google map, routes and traffic, switched on in Settings → Map. Needs the
# Maps JavaScript API and the Routes API enabled. Baked in at build time; restrict the key
# to this site's addresses in the Google Cloud console.
VITE_GOOGLE_MAPS_KEY=
# Optional: another Map ID for the Google map's look. Without it, Mapic's own Map ID
# (Monochrome for light mode, Dark for dark mode) is used.
VITE_GOOGLE_MAP_ID=
