# Copy to .env.local for local development (never commit real values).

# Postgres. Railway: reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:54340/teslamaps

# Public URL of the app (HTTPS on Railway). Used for the Google redirect and secure cookies.
APP_URL=http://localhost:5174

# Email sign-in codes (Resend). Without these, codes are printed to the server log in
# development and the "Email me a code" option is hidden in production.
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in. Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: live traffic (Mapbox Traffic v1 tiles). Baked in at build time.
VITE_MAPBOX_TOKEN=
