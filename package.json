{
  "name": "tesla-maps-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "node --watch --env-file-if-exists=.env.local server/index.ts",
    "dev:api:tesla": "APP_URL=http://localhost:5174 TESLA_FAKE=1 npm run dev:api",
    "tesla:register": "node --env-file-if-exists=.env.local scripts/tesla-register.mjs",
    "build": "npm run typecheck && vite build && node scripts/compress.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview --host",
    "start": "node server/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "perf": "node scripts/perf-drive.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@mapbox/vector-tile": "3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.18",
    "maplibre-gl": "^6.18.0",
    "pbf": "5.1.2",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18"
  }
}
